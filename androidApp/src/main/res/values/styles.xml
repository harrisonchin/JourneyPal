<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, icon and animated duration. -->
        <item name="windowSplashScreenBackground">#00668B</item>

        <!-- Use windowSplashScreenAnimatedIcon to display either a static or animated icon. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <!-- In this case, use a theme that has no action bar. -->
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>
</resources>
